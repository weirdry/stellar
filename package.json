{
  "name": "stellar-work-map",
  "version": "0.1.3-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test test/browser/*.test.ts",
    "browser-install": "playwright install chromium",
    "stellar": "node bin/stellar.ts",
    "types-build": "node scripts/types/declarations.ts",
    "types-check": "node scripts/types/declarations.ts --check",
    "typecheck": "node scripts/types/check.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
